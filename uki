from IPython.display import HTML, display

# Masukkan nama dan pesan Anda di sini
NAMA_PASANGAN = "Sayang"
NAMA_KAMU = "Aku"
PESAN_ANNIVERSARY = """
Terima kasih sudah menemani dan berjalan bersama hingga hari ini.<br>
Semoga hubungan kita selalu dipenuhi kebahagiaan, tawa, dan rasa saling mengerti.<br><br>
<b>Happy Anniversary! I Love You! ❤️✨</b>
"""

# HTML & CSS Code
html_code = f"""
<div id="anniv-container" style="
    background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
    padding: 40px 20px;
    border-radius: 20px;
    text-align: center;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    max-width: 500px;
    margin: 20px auto;
    position: relative;
    overflow: hidden;
">
    <div style="font-size: 60px; animation: beat 1s infinite alternate;" id="heart-emoji">❤️</div>
    <h1 style="color: #d63384; font-size: 28px; margin-top: 10px;">Happy Anniversary!</h1>
    <h3 style="color: #6c757d; margin-bottom: 20px;">{NAMA_PASANGAN} & {NAMA_KAMU}</h3>
    
    <div id="secret-message" style="
        background-color: rgba(255, 255, 255, 0.9);
        padding: 20px;
        border-radius: 15px;
        color: #333;
        font-size: 16px;
        line-height: 1.6;
        display: none;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    ">
        {PESAN_ANNIVERSARY}
    </div>

    <button id="open-btn" onclick="toggleMessage()" style="
        margin-top: 15px;
        background-color: #ff4b2b;
        color: white;
        border: none;
        padding: 12px 25px;
        font-size: 16px;
        border-radius: 25px;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(255, 75, 43, 0.3);
        transition: transform 0.2s;
    ">
        Buka Pesan 💌
    </button>
</div>

<style>
@keyframes beat {{
    0% {{ transform: scale(1); }}
    100% {{ transform: scale(1.25); }}
}}
button:hover {{
    transform: scale(1.05);
}}
</style>

<script>
function toggleMessage() {{
    var msg = document.getElementById("secret-message");
    var btn = document.getElementById("open-btn");
    if (msg.style.display === "none" || msg.style.display === "") {{
        msg.style.display = "block";
        btn.innerHTML = "Tutup Pesan ❤";
        btn.style.backgroundColor = "#d63384";
    }} else {{
        msg.style.display = "none";
        btn.innerHTML = "Buka Pesan 💌";
        btn.style.backgroundColor = "#ff4b2b";
    }}
}}
</script>
"""

# Tampilkan di Jupyter Notebook
display(HTML(html_code))
